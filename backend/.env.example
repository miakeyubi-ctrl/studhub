# =============== STUDHUB BACKEND - 100% NATIF SANS DOCKER ===============
# Copiez ce fichier en .env et remplacez les CHANGE_ME

NODE_ENV=development
PORT=3000

# ========= POSTGRESQL 16 (natif Windows, port 5432) =========
DATABASE_URL="postgresql://studhub:studhub_password@localhost:5432/studhub?schema=public"

# ========= REDIS (natif Windows Memurai/service Redis, port 6379) =========
REDIS_URL="redis://localhost:6379"
REDIS_DB=0

# ========= JWT =========
JWT_ACCESS_SECRET="CHANGE_ME_AuMoins32CaracteresAleatoiresIciStudHub12345"
JWT_REFRESH_SECRET="CHANGE_ME_AutreChaineDifferenteDe32CaracteresMinimum00"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_ISSUER="studhub.tn"
JWT_AUDIENCE="studhub-api"
BCRYPT_COST=12

# ========= CORS =========
CORS_ORIGIN="http://localhost:4200,http://127.0.0.1:4200,http://192.168.1.0/24,capacitor://localhost,http://localhost,ionic://localhost"

# ========= UPLOAD PHOTOS =========
# Valeurs possibles: local | cloudinary
UPLOAD_MODE="local"
UPLOAD_LOCAL_DIR="./uploads"
UPLOAD_PUBLIC_URL_PREFIX="http://localhost:3000/uploads"
UPLOAD_MAX_SIZE_MB=15
UPLOAD_ALLOWED_MIMES="image/jpeg,image/png,image/webp,image/gif,audio/webm,audio/ogg,audio/mpeg,audio/mp4,audio/wav,audio/x-wav,audio/aac,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain"

# ========= CLOUDINARY (si UPLOAD_MODE=cloudinary) =========
CLOUDINARY_CLOUD_NAME="CHANGE_ME"
CLOUDINARY_API_KEY="CHANGE_ME"
CLOUDINARY_API_SECRET="CHANGE_ME"
CLOUDINARY_FOLDER="studhub-dev"

# ========= RATE LIMIT =========
THROTTLE_TTL=60
THROTTLE_LIMIT=200
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=15

# ========= SWAGGER / API DOCS =========
SWAGGER_ENABLED=true
SWAGGER_PATH="docs"
SWAGGER_USER="admin"
SWAGGER_PASS="CHANGE_ME_admin_password"

# ========= LOGS =========
LOG_LEVEL="info"
LOG_PRETTY_PRINT=true

# ========= TWILIO SMS OTP =========
# Laissez vide en local → OTP loggué en console + renvoyé en devCode
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_SMS_TEMPLATE="StudHub — Code de confirmation : {{code}}. Valide 10 min."

# ========= EMAILS (OTP inscription + reset + support) =========
# StudHub utilise la boîte OVH VicciSmart (même que allato.fr) :
# SMTP_HOST=ssl0.ovh.net / USER=contact@viccismart-enr.com
SMTP_HOST="ssl0.ovh.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@viccismart-enr.com"
SMTP_PASS="CHANGE_ME"
# Option B : API Resend (si SMTP vide)
RESEND_API_KEY=
EMAIL_FROM="contact@viccismart-enr.com"
EMAIL_FROM_NAME="StudHub"
SUPPORT_INBOX="contact@viccismart-enr.com"
# En prod : false. En local sans SMTP : true (code OTP en console).
EMAIL_CONSOLE_FALLBACK="false"
EMAIL_RESET_TTL_MINUTES=10

# ========= PUSH NOTIFICATIONS (FCM) =========
# Requis pour notifier quand le téléphone est en veille / app fermée.
# 1) Créer un projet Firebase → Cloud Messaging
# 2) Télécharger la clé de compte de service (JSON)
# 3) Placer le fichier et renseigner le chemin CI-DESSOUS
# FIREBASE_SERVICE_ACCOUNT_PATH="C:/secrets/studhub-firebase-adminsdk.json"
# Ou coller le JSON sur une seule ligne :
# FIREBASE_SERVICE_ACCOUNT_JSON="{...}"
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
