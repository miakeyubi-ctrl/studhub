# StudHub API — production template (copy to .env on the VPS)
NODE_ENV=production
PORT=3000

POSTGRES_USER=studhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=studhub
DATABASE_URL=postgresql://studhub:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/studhub?schema=public

REDIS_URL=redis://redis:6379
REDIS_DB=0

JWT_ACCESS_SECRET=CHANGE_ME_32+_RANDOM_CHARS_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_32+_RANDOM_CHARS_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=studhub.tn
JWT_AUDIENCE=studhub-api
BCRYPT_COST=12

CORS_ORIGIN=https://app.studhub.tn,capacitor://localhost,ionic://localhost,http://localhost:4200

UPLOAD_MODE=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_PUBLIC_URL_PREFIX=https://api.studhub.tn/uploads
UPLOAD_MAX_SIZE_MB=15
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/gif,audio/webm,audio/ogg,audio/mpeg,audio/mp4,audio/wav,audio/x-wav,audio/aac,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain

THROTTLE_TTL=60
THROTTLE_LIMIT=200
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=15

SWAGGER_ENABLED=false
SWAGGER_PATH=docs
SWAGGER_USER=admin
SWAGGER_PASS=CHANGE_ME

LOG_LEVEL=info
LOG_PRETTY_PRINT=false

TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_SMS_TEMPLATE=StudHub: votre code est {{code}}. Valide 10 min.

# Emails — SMTP OVH VicciSmart (même boîte que allato.fr)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@viccismart-enr.com
SMTP_PASS=CHANGE_ME
EMAIL_FROM=contact@viccismart-enr.com
EMAIL_FROM_NAME=StudHub
SUPPORT_INBOX=contact@viccismart-enr.com
EMAIL_CONSOLE_FALLBACK=false
EMAIL_RESET_TTL_MINUTES=10

FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
